NODE_ENV=development
PORT=8080
DATABASE_URL=mysql://root:password@localhost:3306/nodejspro
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-string-of-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# set to .shop.com when the frontend must read the auth cookies (same-site deploy)
COOKIE_DOMAIN=
SESSION_SECRET=change-me-to-another-random-string
CORS_ORIGINS=http://localhost:3000
# required (min 12 chars) when NODE_ENV=production
ADMIN_PASSWORD=
# optional
SENTRY_DSN=
ENABLE_DOCS=false
GIT_SHA=

# docker-compose only
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=nodejspro
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app
