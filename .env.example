NODE_ENV=development
PORT=8080
DATABASE_URL=mysql://root:password@localhost:3306/nodejspro
REDIS_URL=redis://localhost:6379
PRICE_ALERT_INTERVAL_MS=300000
PRICE_ALERT_PRODUCT_BATCH_SIZE=100
PRICE_ALERT_ITEM_BATCH_SIZE=500
PRICE_ALERT_LOCK_TTL_MS=240000
NOTIFICATION_OUTBOX_ENABLED=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_QUEUE_PREFIX=laptopshop
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=60000
DELIVERY_MAX_ATTEMPTS=5
FLASH_SALE_PRICE_ALERT_ENABLED=false
PRICE_RESOLVER_SHADOW_MODE=false
WEB_PUSH_ENABLED=false
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=LaptopShop <no-reply@laptopshop.test>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_OTP_ENCRYPTION_KEY=
EMAIL_OTP_KEY_VERSION=v1
JWT_SECRET=change-me-to-a-random-string-of-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# set to .shop.com when the frontend must read the auth cookies (same-site deploy)
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
STOREFRONT_ORIGIN=http://localhost:3000
# required (min 12 chars) when NODE_ENV=production
ADMIN_PASSWORD=
# optional
SENTRY_DSN=
ENABLE_DOCS=false
GIT_SHA=

# QR payment: keep disabled until SePay Test/Live credentials and reconciliation are verified
BANK_TRANSFER_ENABLED=false
PAYMENT_PROVIDER=fake
SEPAY_MODE=test
PAYMENT_TTL_MINUTES=15
PAYMENT_GRACE_SECONDS=120
PAYMENT_EVENT_ENCRYPTION_KEY=
PAYMENT_EVENT_KEY_ID=payment-key-v1
PAYMENT_RECONCILIATION_INTERVAL_MS=120000
PAYMENT_RECONCILIATION_SETTLEMENT_SECONDS=300
PAYMENT_MAX_AUTO_HOLD_MINUTES=60
SEPAY_API_TIMEOUT_MS=10000
PAYMENT_RECONCILIATION_LEASE_MS=60000
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# AI Laptop Advisor (keep disabled until the provider model/quota is verified)
ADVISOR_AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_STRUCTURED_OUTPUT_MODE=json_object
ADVISOR_AI_TIMEOUT_MS=10000
ADVISOR_AI_MAX_OUTPUT_TOKENS=500
ADVISOR_GUEST_DAILY_LIMIT=5
ADVISOR_USER_DAILY_LIMIT=10
ADVISOR_GLOBAL_DAILY_LIMIT=30

# Review images: set REVIEW_IMAGES_ENABLED=true only after private S3/MinIO is ready
REVIEW_IMAGES_ENABLED=false
AFTER_SALES_IMAGES_ENABLED=false
AFTER_SALES_IMAGE_S3_ENDPOINT=
AFTER_SALES_IMAGE_S3_REGION=
AFTER_SALES_IMAGE_S3_BUCKET=
AFTER_SALES_IMAGE_S3_ACCESS_KEY_ID=
AFTER_SALES_IMAGE_S3_SECRET_ACCESS_KEY=
AFTER_SALES_IMAGE_S3_FORCE_PATH_STYLE=false
AFTER_SALES_IMAGE_URL_TTL_SECONDS=900
AFTER_SALES_ATTACHMENT_PENDING_TTL_MS=3600000
AFTER_SALES_ATTACHMENT_CLEANUP_BATCH_SIZE=100
AFTER_SALES_WORKER_ENABLED=false
AFTER_SALES_QUEUE_PREFIX=bull
REVIEW_IMAGE_S3_ENDPOINT=
REVIEW_IMAGE_S3_REGION=
REVIEW_IMAGE_S3_BUCKET=
REVIEW_IMAGE_S3_ACCESS_KEY_ID=
REVIEW_IMAGE_S3_SECRET_ACCESS_KEY=
REVIEW_IMAGE_S3_FORCE_PATH_STYLE=false
REVIEW_IMAGE_URL_TTL_SECONDS=900

# docker-compose only
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=nodejspro
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app
RUSTFS_ACCESS_KEY=rustfs-local
RUSTFS_SECRET_KEY=change-me-rustfs-password
