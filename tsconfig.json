{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "config/*": ["./src/config/*"],
      "middlewares/*": ["./src/middlewares/*"],
      "models/*": ["./src/models/*"],
      "routes/*": ["./src/routes/*"],
      "lib/*": ["./src/lib/*"],
      "docs/*": ["./src/docs/*"],
      "modules/*": ["./src/modules/*"],
    }
  },
  "include": ["src", "tests", "jest.config.ts", "jest.int.config.ts"]
}
