// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReviewImageStatus {
  PENDING
  READY
  DELETING
}

enum PromotionKind {
  COUPON
  AUTOMATIC
  FLASH_SALE
}

enum PromotionState {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum DiscountKind {
  PERCENT
  FIXED
}

enum CouponScope {
  ORDER
  PRODUCT
}

enum RedemptionStatus {
  APPLIED
  REVERSED
}

enum FlashSaleAllocationStatus {
  CLAIMED
  RELEASED
}

enum PriceAlertMode {
  PERCENT_DROP
  TARGET_PRICE
}

enum NotificationType {
  PRICE_DROP
}

model User {
  id          Int     @id @default(autoincrement())
  username    String  @unique @db.VarChar(255)
  password    String  @db.VarChar(255)
  fullName    String? @db.VarChar(255)
  address     String? @db.VarChar(255)
  phone       String? @db.VarChar(255)
  accountType String? @db.VarChar(50)
  avatar      String? @db.VarChar(255)
  role        Role    @relation(fields: [roleId], references: [id])
  roleId      Int

  Cart                    Cart?
  orders                  Order[]
  refreshTokens           RefreshToken[]
  statusChanges           OrderStatusHistory[]
  stockMovements          StockMovement[]
  paymentEventResolutions PaymentWebhookEvent[]
  stockReceiptsCreated    StockReceipt[]        @relation("ReceiptCreator")
  stockReceiptsPosted     StockReceipt[]        @relation("ReceiptPoster")
  reviews                 Review[]              @relation("ReviewAuthor")
  moderatedReviews        Review[]              @relation("ReviewModerator")
  reviewHelpfulVotes      ReviewHelpful[]
  reviewRepliesCreated    ReviewReply[]         @relation("ReviewReplyCreator")
  reviewRepliesUpdated    ReviewReply[]         @relation("ReviewReplyUpdater")
  flashSaleUsages         FlashSaleUserUsage[]
  flashSaleAllocations    FlashSaleAllocation[]
  promotionsCreated       Promotion[]           @relation("PromotionCreator")
  promotionsUpdated       Promotion[]           @relation("PromotionUpdater")
  promotionUsages         PromotionUserUsage[]
  promotionRedemptions    PromotionRedemption[]
  wishlistItems           WishlistItem[]
  notifications           Notification[]

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  users       User[]

  @@map("roles")
}

model Product {
  id               Int     @id @default(autoincrement())
  name             String  @db.VarChar(255)
  price            Int
  image            String? @db.VarChar(255)
  detailDesc       String? @db.MediumText
  shortDesc        String? @db.VarChar(255)
  quantity         Int
  sold             Int?    @default(0)
  factory          String? @db.VarChar(255)
  target           String? @db.VarChar(255)
  isActive         Boolean @default(true)
  cpu              String? @db.VarChar(255)
  gpu              String? @db.VarChar(255)
  cpuBrand         String? @db.VarChar(20)
  gpuBrand         String? @db.VarChar(20)
  gpuType          String? @db.VarChar(20)
  ramGb            Int?
  storageGb        Int?
  screenSizeInch   Float?
  screenResolution String? @db.VarChar(50)
  resolutionTier   String? @db.VarChar(20)
  panelType        String? @db.VarChar(20)
  refreshRateHz    Int?
  batteryWh        Int?
  weightGrams      Int?
  warrantyMonths   Int?

  cartDetails      CartDetail[]
  orderDetails     OrderDetail[]
  stockMovements   StockMovement[]
  receiptItems     StockReceiptItem[]
  promotionTargets PromotionProduct[]
  flashSaleQuotas  FlashSaleProductQuota[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  notifications    Notification[]

  @@map("products")
}

model WishlistItem {
  id               Int             @id @default(autoincrement())
  userId           Int
  productId        Int
  alertMode        PriceAlertMode?
  targetPrice      Int?
  referencePrice   Int?
  lastAlertMode    PriceAlertMode?
  lastAlertedPrice Int?
  lastAlertedAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, alertMode])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  productId Int?
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.VarChar(500)
  oldPrice  Int?
  newPrice  Int?
  dedupeKey String           @unique @db.VarChar(191)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Cart {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  cartDetails CartDetail[]

  @@map("cart")
}

model CartDetail {
  id       Int @id @default(autoincrement())
  quantity Int

  cart   Cart @relation(fields: [cartId], references: [id])
  cartId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  @@unique([cartId, productId])
  @@map("cart_detail")
}

model Order {
  id                     Int     @id @default(autoincrement())
  totalPrice             Int
  subtotalPrice          Int
  productDiscountAmount  Int     @default(0)
  couponEligibleSubtotal Int     @default(0)
  couponDiscountAmount   Int     @default(0)
  couponPromotionId      Int?
  couponCode             String? @db.VarChar(50)
  couponName             String? @db.VarChar(150)
  requestHash            String? @db.Char(64)
  receiverAddress        String  @db.VarChar(255)
  receiverName           String  @db.VarChar(255)
  receiverPhone          String  @db.VarChar(255)
  status                 String  @default("PENDING") // PENDING, COMPLETED, CANCELLED

  paymentMethod  String // COD, BANK...
  paymentStatus  String // PAYMENT_UNPAID, PAYMENT_SUCCESS, PAYMENT_FAILED
  paymentRef     String?
  idempotencyKey String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  user                 User                  @relation(fields: [userId], references: [id])
  userId               Int
  orderDetails         OrderDetail[]
  history              OrderStatusHistory[]
  stockMovements       StockMovement[]
  payment              Payment?
  couponPromotion      Promotion?            @relation("OrderCouponPromotion", fields: [couponPromotionId], references: [id], onDelete: Restrict)
  couponRedemption     PromotionRedemption?
  flashSaleAllocations FlashSaleAllocation[]

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderDetail {
  id                     Int     @id @default(autoincrement())
  price                  Int
  quantity               Int
  productDiscountAmount  Int     @default(0)
  couponDiscountAmount   Int     @default(0)
  automaticPromotionId   Int?
  automaticPromotionName String? @db.VarChar(150)

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  review              Review?
  automaticPromotion  Promotion?           @relation("OrderDetailAutomaticPromotion", fields: [automaticPromotionId], references: [id], onDelete: Restrict)
  flashSaleAllocation FlashSaleAllocation?

  @@map("order_detail")
}

model Promotion {
  id             Int            @id @default(autoincrement())
  kind           PromotionKind
  state          PromotionState @default(DRAFT)
  name           String         @db.VarChar(150)
  description    String?        @db.VarChar(500)
  discountKind   DiscountKind
  discountValue  Int
  pricingVersion Int            @default(1)
  startsAt       DateTime
  endsAt         DateTime
  activatedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdById Int
  updatedById Int

  createdBy User @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("PromotionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  couponPolicy    CouponPolicy?
  automaticPolicy AutomaticPromotionPolicy?
  flashSalePolicy FlashSalePolicy?
  products        PromotionProduct[]
  redemptions     PromotionRedemption[]
  userUsages      PromotionUserUsage[]
  couponOrders    Order[]                   @relation("OrderCouponPromotion")
  automaticLines  OrderDetail[]             @relation("OrderDetailAutomaticPromotion")
  flashSaleQuotas FlashSaleProductQuota[]

  @@index([kind, state, startsAt, endsAt])
  @@map("promotions")
}

model CouponPolicy {
  promotionId    Int         @id
  code           String      @unique @db.VarChar(50)
  scope          CouponScope
  minOrderValue  Int         @default(0)
  maxDiscount    Int?
  maxUses        Int?
  usedCount      Int         @default(0)
  maxUsesPerUser Int         @default(1)
  isPublic       Boolean     @default(false)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([isPublic])
  @@map("coupon_policies")
}

model AutomaticPromotionPolicy {
  promotionId         Int     @id
  priority            Int     @default(0)
  stackableWithCoupon Boolean @default(false)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([priority])
  @@map("automatic_promotion_policies")
}

model PromotionProduct {
  promotionId Int
  productId   Int

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([promotionId, productId])
  @@index([productId, promotionId])
  @@map("promotion_products")
}

model PromotionUserUsage {
  promotionId Int
  userId      Int
  usedCount   Int @default(0)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([promotionId, userId])
  @@map("promotion_user_usages")
}

model PromotionRedemption {
  id             Int              @id @default(autoincrement())
  promotionId    Int
  userId         Int
  orderId        Int              @unique
  discountAmount Int
  status         RedemptionStatus @default(APPLIED)
  createdAt      DateTime         @default(now())
  reversedAt     DateTime?
  reverseReason  String?          @db.VarChar(50)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([promotionId, status, createdAt])
  @@index([userId, promotionId, status])
  @@map("promotion_redemptions")
}

model FlashSalePolicy {
  promotionId         Int     @id
  priority            Int     @default(0)
  stackableWithCoupon Boolean @default(false)
  showRemainingQuota  Boolean @default(true)

  promotion Promotion               @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  quotas    FlashSaleProductQuota[]

  @@map("flash_sale_policies")
}

model FlashSaleProductQuota {
  promotionId     Int
  productId       Int
  totalQuota      Int
  claimedUnits    Int      @default(0)
  maxUnitsPerUser Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  promotion   Promotion             @relation(fields: [promotionId], references: [id], onDelete: Restrict, map: "flash_sale_product_quotas_promotion_fkey")
  policy      FlashSalePolicy       @relation(fields: [promotionId], references: [promotionId], onDelete: Restrict, map: "flash_sale_product_quotas_policy_fkey")
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  usages      FlashSaleUserUsage[]
  allocations FlashSaleAllocation[]

  @@id([promotionId, productId])
  @@index([productId, promotionId])
  @@map("flash_sale_product_quotas")
}

model FlashSaleUserUsage {
  promotionId  Int
  productId    Int
  userId       Int
  claimedUnits Int @default(0)

  quota FlashSaleProductQuota @relation(fields: [promotionId, productId], references: [promotionId, productId], onDelete: Restrict)
  user  User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([promotionId, productId, userId])
  @@index([userId, promotionId])
  @@map("flash_sale_user_usages")
}

model FlashSaleAllocation {
  id             Int                       @id @default(autoincrement())
  promotionId    Int
  productId      Int
  userId         Int
  orderId        Int
  orderDetailId  Int                       @unique
  quantity       Int
  discountAmount Int
  status         FlashSaleAllocationStatus @default(CLAIMED)
  createdAt      DateTime                  @default(now())
  releasedAt     DateTime?
  releaseReason  String?                   @db.VarChar(50)

  quota       FlashSaleProductQuota @relation(fields: [promotionId, productId], references: [promotionId, productId], onDelete: Restrict)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderDetail OrderDetail           @relation(fields: [orderDetailId], references: [id], onDelete: Restrict)

  @@unique([promotionId, productId, orderId])
  @@index([promotionId, productId, status])
  @@index([userId, promotionId, status])
  @@index([createdAt])
  @@map("flash_sale_allocations")
}

model Review {
  id            Int @id @default(autoincrement())
  userId        Int
  productId     Int
  orderDetailId Int @unique

  rating           Int          @db.UnsignedTinyInt
  title            String?      @db.VarChar(150)
  content          String       @db.VarChar(1500)
  isAnonymous      Boolean
  status           ReviewStatus @default(PUBLISHED)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  contentUpdatedAt DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  hiddenReason  String?   @db.VarChar(500)
  moderatedAt   DateTime?
  moderatedById Int?

  images       ReviewImage[]
  helpfulVotes ReviewHelpful[]
  reply        ReviewReply?

  user        User        @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id], onDelete: Restrict)
  moderatedBy User?       @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status, deletedAt, createdAt])
  @@index([status, deletedAt, createdAt])
  @@map("reviews")
}

model ReviewImage {
  id               Int               @id @default(autoincrement())
  reviewId         Int
  objectKey        String            @unique @db.VarChar(512)
  mimeType         String            @db.VarChar(50)
  byteSize         Int
  width            Int
  height           Int
  position         Int               @db.UnsignedTinyInt
  status           ReviewImageStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  storageDeletedAt DateTime?

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([reviewId, status, position])
  @@index([status, updatedAt])
  @@map("review_images")
}

model ReviewHelpful {
  reviewId  Int
  userId    Int
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([reviewId, userId])
  @@index([userId, createdAt])
  @@map("review_helpful")
}

model ReviewReply {
  id          Int       @id @default(autoincrement())
  reviewId    Int       @unique
  content     String    @db.VarChar(1000)
  createdById Int
  updatedById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  createdBy User   @relation("ReviewReplyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User   @relation("ReviewReplyUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([deletedAt, updatedAt])
  @@map("review_replies")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.Char(64)
  familyId  String    @db.Char(36)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(255)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@index([familyId])
  @@map("refresh_tokens")
}

model OrderStatusHistory {
  id         Int      @id @default(autoincrement())
  fromStatus String?  @db.VarChar(20)
  toStatus   String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId Int?
  reason  String? @db.VarChar(50)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id            String    @id @default(uuid()) @db.Char(36)
  orderId       Int       @unique
  provider      String    @db.VarChar(20)
  method        String    @default("BANK_TRANSFER") @db.VarChar(30)
  status        String    @default("PENDING") @db.VarChar(20)
  amount        Int
  currency      String    @default("VND") @db.Char(3)
  transferCode  String    @unique @db.VarChar(32)
  bankCode      String    @db.VarChar(30)
  accountNumber String    @db.VarChar(64)
  accountName   String    @db.VarChar(255)
  expiresAt     DateTime
  cancelAfter   DateTime
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id])
  webhookEvents PaymentWebhookEvent[]

  @@index([status, cancelAfter])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                     String    @id @default(uuid()) @db.Char(36)
  provider               String    @db.VarChar(20)
  source                 String    @db.VarChar(20)
  providerEventId        String    @db.VarChar(150)
  providerTransactionKey String    @db.VarChar(150)
  paymentId              String?
  direction              String    @db.VarChar(10)
  amount                 Int
  currency               String    @default("VND") @db.Char(3)
  transferCode           String?   @db.VarChar(64)
  accountNumber          String?   @db.VarChar(64)
  occurredAt             DateTime?
  status                 String    @default("REVIEW_REQUIRED") @db.VarChar(30)
  reviewReason           String?   @db.VarChar(40)
  payloadHash            String    @db.Char(64)
  rawPayload             Bytes?    @db.LongBlob
  rawPayloadIv           Bytes?    @db.VarBinary(16)
  rawPayloadTag          Bytes?    @db.VarBinary(16)
  encryptionKeyId        String?   @db.VarChar(32)
  note                   String?   @db.VarChar(500)
  receivedAt             DateTime  @default(now())
  resolvedAt             DateTime?
  resolvedById           Int?

  payment    Payment? @relation(fields: [paymentId], references: [id])
  resolvedBy User?    @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@unique([provider, providerTransactionKey])
  @@index([status, receivedAt])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model PaymentProviderCheckpoint {
  id              Int       @id @default(autoincrement())
  provider        String    @db.VarChar(20)
  mode            String    @db.VarChar(20)
  cursor          String?   @db.VarChar(150)
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastErrorAt     DateTime?
  lastError       String?   @db.VarChar(500)
  updatedAt       DateTime  @updatedAt

  @@unique([provider, mode])
  @@map("payment_provider_checkpoints")
}

model StockMovement {
  id             Int      @id @default(autoincrement())
  delta          Int
  reason         String   @db.VarChar(20)
  note           String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  balanceBefore  Int
  balanceAfter   Int
  idempotencyKey String?  @db.VarChar(64)
  requestHash    String?  @db.Char(64)

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId Int?

  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId Int?

  receipt   StockReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  receiptId String?       @db.Char(36)

  @@unique([actorId, idempotencyKey])
  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([receiptId])
  @@map("stock_movements")
}

model StockReceipt {
  id           String    @id @default(uuid()) @db.Char(36)
  code         String    @unique @db.VarChar(40)
  supplierName String?   @db.VarChar(255)
  status       String    @default("DRAFT") @db.VarChar(20)
  note         String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  postedAt     DateTime?

  createdBy   User  @relation("ReceiptCreator", fields: [createdById], references: [id])
  createdById Int
  postedBy    User? @relation("ReceiptPoster", fields: [postedById], references: [id])
  postedById  Int?

  items     StockReceiptItem[]
  movements StockMovement[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id        Int    @id @default(autoincrement())
  receiptId String @db.Char(36)
  productId Int
  quantity  Int
  unitCost  Int?

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([receiptId, productId])
  @@index([productId])
  @@map("stock_receipt_items")
}
