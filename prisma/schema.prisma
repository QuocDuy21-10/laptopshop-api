// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReviewImageStatus {
  PENDING
  READY
  DELETING
}

enum PromotionKind {
  COUPON
  AUTOMATIC
  FLASH_SALE
}

enum PromotionState {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum DiscountKind {
  PERCENT
  FIXED
}

enum CouponScope {
  ORDER
  PRODUCT
}

enum RedemptionStatus {
  APPLIED
  REVERSED
}

enum FlashSaleAllocationStatus {
  CLAIMED
  RELEASED
}

enum PriceAlertMode {
  PERCENT_DROP
  TARGET_PRICE
}

enum WarrantyPolicySource {
  CHECKOUT_SNAPSHOT
  CURRENT_PRODUCT_POLICY_BACKFILL
  UNAVAILABLE
}

enum WarrantyCoverage {
  IN_WARRANTY
  OUT_OF_WARRANTY
  NO_WARRANTY
  REQUIRES_VERIFICATION
}

enum WarrantyVerificationDecision {
  IN_WARRANTY
  OUT_OF_WARRANTY
  NO_WARRANTY
  UNVERIFIABLE
}

enum ServiceRequestType {
  WARRANTY
  TECHNICAL_SUPPORT
}

enum ServiceRequestStatus {
  SUBMITTED
  REVIEWING
  IN_PROGRESS
  AWAITING_CUSTOMER
  PARTIALLY_COMPLETED
  CLOSED
}

enum ServiceRequestItemStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  AWAITING_ITEM
  RECEIVED
  DIAGNOSING
  AWAITING_QUOTE_DECISION
  IN_SERVICE
  READY_FOR_RETURN
  RETURNED
  RESOLVED
  CLOSED
  REJECTED
  CANCELLED
}

enum ServiceItemCloseReason {
  CUSTOMER_CONFIRMED
  CUSTOMER_CONFIRMATION_TIMEOUT
  ADMINISTRATIVE
  REJECTED
  CUSTOMER_CANCELLED
}

enum ServiceEventKind {
  REQUEST_CREATED
  STATUS_CHANGED
  PUBLIC_MESSAGE
  INTERNAL_NOTE
  ASSIGNED
  QUOTE_SENT
  QUOTE_DECIDED
  DEVICE_RETURNED
  CUSTOMER_CONFIRMED
  COMPLETION_DISPUTED
  AUTO_CLOSED
  ADMIN_CLOSED
  FOLLOW_UP_CREATED
  WARRANTY_VERIFIED
  ATTACHMENT_REDACTED
}

enum ServiceEventVisibility {
  PUBLIC
  INTERNAL
}

enum ServiceAttachmentStatus {
  PENDING
  READY
  DELETING
}

enum ServiceQuoteStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum NotificationType {
  PRICE_DROP
  AFTER_SALES_MESSAGE
  AFTER_SALES_STATUS_CHANGED
  AFTER_SALES_QUOTE_SENT
  AFTER_SALES_CONFIRMATION_REQUIRED
  AFTER_SALES_AUTO_CLOSED
}

enum NotificationPriceSource {
  LIST_PRICE
  AUTOMATIC
  FLASH_SALE
}

enum NotificationChannel {
  EMAIL
  WEB_PUSH
}

enum NotificationDeliveryParent {
  NOTIFICATION
  EMAIL_VERIFICATION
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRYING
  FAILED
  DEAD
  CANCELLED
  SUPPRESSED
}

enum OutboxEventType {
  PRICE_REEVALUATION_REQUESTED
  NOTIFICATION_DELIVERY_REQUESTED
  AFTER_SALES_MILESTONE_REQUESTED
  AFTER_SALES_ATTACHMENT_DELETE_REQUESTED
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique @db.VarChar(255)
  password        String    @db.VarChar(255)
  fullName        String?   @db.VarChar(255)
  address         String?   @db.VarChar(255)
  phone           String?   @db.VarChar(255)
  accountType     String?   @db.VarChar(50)
  avatar          String?   @db.VarChar(255)
  emailVerifiedAt DateTime?
  role            Role      @relation(fields: [roleId], references: [id])
  roleId          Int

  Cart                        Cart?
  orders                      Order[]
  refreshTokens               RefreshToken[]
  statusChanges               OrderStatusHistory[]
  stockMovements              StockMovement[]
  paymentEventResolutions     PaymentWebhookEvent[]
  stockReceiptsCreated        StockReceipt[]               @relation("ReceiptCreator")
  stockReceiptsPosted         StockReceipt[]               @relation("ReceiptPoster")
  reviews                     Review[]                     @relation("ReviewAuthor")
  moderatedReviews            Review[]                     @relation("ReviewModerator")
  reviewHelpfulVotes          ReviewHelpful[]
  reviewRepliesCreated        ReviewReply[]                @relation("ReviewReplyCreator")
  reviewRepliesUpdated        ReviewReply[]                @relation("ReviewReplyUpdater")
  flashSaleUsages             FlashSaleUserUsage[]
  flashSaleAllocations        FlashSaleAllocation[]
  promotionsCreated           Promotion[]                  @relation("PromotionCreator")
  promotionsUpdated           Promotion[]                  @relation("PromotionUpdater")
  promotionUsages             PromotionUserUsage[]
  promotionRedemptions        PromotionRedemption[]
  wishlistItems               WishlistItem[]
  notifications               Notification[]
  notificationPreference      NotificationPreference?
  emailVerificationChallenges EmailVerificationChallenge[]
  pushSubscriptions           PushSubscription[]
  deliveryAudits              NotificationDeliveryAudit[]  @relation("DeliveryAuditActor")
  afterSalesRequests          ServiceRequest[]             @relation("AfterSalesCustomer")
  assignedAfterSalesRequests  ServiceRequest[]             @relation("AfterSalesAssignee")
  afterSalesEvents            ServiceRequestEvent[]        @relation("AfterSalesEventActor")
  afterSalesAttachments       ServiceRequestAttachment[]   @relation("AfterSalesAttachmentUploader")
  afterSalesQuotes            ServiceQuote[]               @relation("AfterSalesQuoteCreator")
  warrantyVerifications       WarrantyVerification[]       @relation("WarrantyVerificationVerifier")

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  users       User[]

  @@map("roles")
}

model Product {
  id               Int     @id @default(autoincrement())
  name             String  @db.VarChar(255)
  price            Int
  image            String? @db.VarChar(255)
  detailDesc       String? @db.MediumText
  shortDesc        String? @db.VarChar(255)
  quantity         Int
  sold             Int?    @default(0)
  factory          String? @db.VarChar(255)
  target           String? @db.VarChar(255)
  isActive         Boolean @default(true)
  cpu              String? @db.VarChar(255)
  gpu              String? @db.VarChar(255)
  cpuBrand         String? @db.VarChar(20)
  gpuBrand         String? @db.VarChar(20)
  gpuType          String? @db.VarChar(20)
  ramGb            Int?
  storageGb        Int?
  screenSizeInch   Float?
  screenResolution String? @db.VarChar(50)
  resolutionTier   String? @db.VarChar(20)
  panelType        String? @db.VarChar(20)
  refreshRateHz    Int?
  batteryWh        Int?
  weightGrams      Int?
  warrantyMonths   Int?

  cartDetails      CartDetail[]
  orderDetails     OrderDetail[]
  stockMovements   StockMovement[]
  receiptItems     StockReceiptItem[]
  promotionTargets PromotionProduct[]
  flashSaleQuotas  FlashSaleProductQuota[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  notifications    Notification[]

  @@map("products")
}

model WishlistItem {
  id               Int             @id @default(autoincrement())
  userId           Int
  productId        Int
  alertMode        PriceAlertMode?
  targetPrice      Int?
  referencePrice   Int?
  includeFlashSale Boolean         @default(false)
  alertVersion     Int             @default(1)
  lastAlertMode    PriceAlertMode?
  lastAlertedPrice Int?
  lastAlertedAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, alertMode])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model Notification {
  id               Int                      @id @default(autoincrement())
  userId           Int
  productId        Int?
  serviceRequestId Int?
  type             NotificationType
  title            String                   @db.VarChar(255)
  message          String                   @db.VarChar(500)
  oldPrice         Int?
  newPrice         Int?
  priceSource      NotificationPriceSource?
  promotionId      Int?
  pricingVersion   Int?
  validUntil       DateTime?
  dedupeKey        String                   @unique @db.VarChar(191)
  readAt           DateTime?
  createdAt        DateTime                 @default(now())

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest?        @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([serviceRequestId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                       Int      @id @default(autoincrement())
  userId                   Int      @unique
  emailEnabled             Boolean  @default(false)
  webPushEnabled           Boolean  @default(false)
  afterSalesEmailEnabled   Boolean  @default(true)
  afterSalesWebPushEnabled Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model EmailVerificationChallenge {
  id                   Int       @id @default(autoincrement())
  userId               Int
  email                String    @db.VarChar(255)
  otpHash              String    @db.VarChar(255)
  otpCiphertext        String    @db.Text
  otpIv                String    @db.VarChar(64)
  otpTag               String    @db.VarChar(64)
  encryptionKeyVersion String    @db.VarChar(32)
  expiresAt            DateTime
  failedAttempts       Int       @default(0)
  sendCount            Int       @default(0)
  lastSentAt           DateTime?
  consumedAt           DateTime?
  invalidatedAt        DateTime?
  createdAt            DateTime  @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, consumedAt, invalidatedAt, expiresAt])
  @@map("email_verification_challenges")
}

model PushSubscription {
  id           Int       @id @default(autoincrement())
  userId       Int
  endpoint     String    @db.Text
  endpointHash String    @unique @db.Char(64)
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userAgent    String?   @db.VarChar(255)
  lastSeenAt   DateTime  @default(now())
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, disabledAt])
  @@map("push_subscriptions")
}

model NotificationDelivery {
  id                           Int                        @id @default(autoincrement())
  notificationId               Int?
  emailVerificationChallengeId Int?
  pushSubscriptionId           Int?
  parentType                   NotificationDeliveryParent
  channel                      NotificationChannel
  status                       NotificationDeliveryStatus @default(PENDING)
  dedupeKey                    String                     @unique @db.VarChar(191)
  destinationKey               String                     @db.VarChar(255)
  destinationSnapshot          String?                    @db.Text
  attemptCount                 Int                        @default(0)
  nextAttemptAt                DateTime?
  leaseOwner                   String?                    @db.VarChar(128)
  leaseExpiresAt               DateTime?
  providerMessageId            String?                    @db.VarChar(255)
  normalizedErrorCode          String?                    @db.VarChar(100)
  lastErrorAt                  DateTime?
  deliveredAt                  DateTime?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  notification               Notification?               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  emailVerificationChallenge EmailVerificationChallenge? @relation(fields: [emailVerificationChallengeId], references: [id], onDelete: Cascade)
  pushSubscription           PushSubscription?           @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)
  audits                     NotificationDeliveryAudit[]

  @@index([status, nextAttemptAt])
  @@index([notificationId, channel])
  @@index([emailVerificationChallengeId, channel])
  @@map("notification_deliveries")
}

model NotificationDeliveryAudit {
  id         Int      @id @default(autoincrement())
  deliveryId Int
  actorId    Int?
  action     String   @db.VarChar(50)
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  actor    User?                @relation("DeliveryAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
  @@map("notification_delivery_audits")
}

model OutboxEvent {
  id              Int             @id @default(autoincrement())
  eventType       OutboxEventType
  schemaVersion   Int             @default(1)
  aggregateType   String          @db.VarChar(100)
  aggregateId     Int
  dedupeKey       String          @unique @db.VarChar(191)
  payload         Json
  availableAt     DateTime        @default(now())
  leaseOwner      String?         @db.VarChar(128)
  leaseExpiresAt  DateTime?
  publishAttempts Int             @default(0)
  publishedAt     DateTime?
  lastErrorCode   String?         @db.VarChar(100)
  createdAt       DateTime        @default(now())

  @@index([publishedAt, availableAt, leaseExpiresAt])
  @@map("outbox_events")
}

model WorkerHeartbeat {
  id         Int      @id @default(autoincrement())
  workerName String   @db.VarChar(100)
  instanceId String   @db.VarChar(128)
  status     String   @db.VarChar(32)
  lastSeenAt DateTime @default(now())
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workerName, instanceId])
  @@index([workerName, lastSeenAt])
  @@map("worker_heartbeats")
}

model WorkerCheckpoint {
  workerName          String   @id @db.VarChar(100)
  ownerEpoch          Int      @default(0)
  ownerToken          String?  @db.VarChar(128)
  cursor              Json?
  cycleStartedAt      DateTime?
  lastStartedAt       DateTime?
  lastCompletedAt     DateTime?
  lastSucceededAt     DateTime?
  lastDurationMs      Int?
  consecutiveFailures Int      @default(0)
  lastErrorCode       String?  @db.VarChar(100)
  lastStats           Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("worker_checkpoints")
}

model Cart {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  cartDetails CartDetail[]

  @@map("cart")
}

model CartDetail {
  id       Int @id @default(autoincrement())
  quantity Int

  cart   Cart @relation(fields: [cartId], references: [id])
  cartId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  @@unique([cartId, productId])
  @@map("cart_detail")
}

model Order {
  id                     Int     @id @default(autoincrement())
  totalPrice             Int
  subtotalPrice          Int
  productDiscountAmount  Int     @default(0)
  couponEligibleSubtotal Int     @default(0)
  couponDiscountAmount   Int     @default(0)
  couponPromotionId      Int?
  couponCode             String? @db.VarChar(50)
  couponName             String? @db.VarChar(150)
  requestHash            String? @db.Char(64)
  receiverAddress        String  @db.VarChar(255)
  receiverName           String  @db.VarChar(255)
  receiverPhone          String  @db.VarChar(255)
  status                 String  @default("PENDING") // PENDING, COMPLETED, CANCELLED

  paymentMethod  String // COD, BANK...
  paymentStatus  String // PAYMENT_UNPAID, PAYMENT_SUCCESS, PAYMENT_FAILED
  paymentRef     String?
  idempotencyKey String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  user                 User                  @relation(fields: [userId], references: [id])
  userId               Int
  orderDetails         OrderDetail[]
  history              OrderStatusHistory[]
  stockMovements       StockMovement[]
  payment              Payment?
  couponPromotion      Promotion?            @relation("OrderCouponPromotion", fields: [couponPromotionId], references: [id], onDelete: Restrict)
  couponRedemption     PromotionRedemption?
  flashSaleAllocations FlashSaleAllocation[]

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderDetail {
  id                     Int                  @id @default(autoincrement())
  price                  Int
  quantity               Int
  productDiscountAmount  Int                  @default(0)
  couponDiscountAmount   Int                  @default(0)
  automaticPromotionId   Int?
  automaticPromotionName String?              @db.VarChar(150)
  warrantyMonthsSnapshot Int?
  warrantyStartAt        DateTime?
  warrantyEndAt          DateTime?
  warrantyPolicySource   WarrantyPolicySource @default(UNAVAILABLE)

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  review                Review?
  serviceRequestItems   ServiceRequestItem[]
  warrantyVerifications WarrantyVerification[]
  automaticPromotion    Promotion?             @relation("OrderDetailAutomaticPromotion", fields: [automaticPromotionId], references: [id], onDelete: Restrict)
  flashSaleAllocation   FlashSaleAllocation?

  @@map("order_detail")
}

model ServiceRequest {
  id                Int                  @id @default(autoincrement())
  code              String               @unique @db.VarChar(32)
  userId            Int
  type              ServiceRequestType
  status            ServiceRequestStatus @default(SUBMITTED)
  subject           String               @db.VarChar(200)
  assignedToId      Int?
  previousRequestId Int?
  idempotencyKey    String               @db.VarChar(64)
  requestHash       String               @db.Char(64)
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  closedAt          DateTime?

  customer        User                       @relation("AfterSalesCustomer", fields: [userId], references: [id], onDelete: Restrict)
  assignee        User?                      @relation("AfterSalesAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  previousRequest ServiceRequest?            @relation("AfterSalesFollowUp", fields: [previousRequestId], references: [id], onDelete: SetNull)
  followUps       ServiceRequest[]           @relation("AfterSalesFollowUp")
  items           ServiceRequestItem[]
  events          ServiceRequestEvent[]
  attachments     ServiceRequestAttachment[]
  notifications   Notification[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([previousRequestId])
  @@map("service_requests")
}

model ServiceRequestItem {
  id                     Int                      @id @default(autoincrement())
  serviceRequestId       Int
  orderDetailId          Int
  position               Int                      @db.UnsignedSmallInt
  productNameSnapshot    String                   @db.VarChar(255)
  deviceLabel            String                   @db.VarChar(100)
  serialNumber           String?                  @db.VarChar(100)
  serialNumberNormalized String?                  @db.VarChar(100)
  issueDescription       String                   @db.Text
  coverageAtCreation     WarrantyCoverage
  status                 ServiceRequestItemStatus @default(SUBMITTED)
  resolution             String?                  @db.Text
  version                Int                      @default(1)
  resolvedAt             DateTime?
  returnedAt             DateTime?
  confirmationDueAt      DateTime?
  customerConfirmedAt    DateTime?
  closedAt               DateTime?
  closeReason            ServiceItemCloseReason?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  request               ServiceRequest             @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  orderDetail           OrderDetail                @relation(fields: [orderDetailId], references: [id], onDelete: Restrict)
  events                ServiceRequestEvent[]
  attachments           ServiceRequestAttachment[]
  quotes                ServiceQuote[]
  warrantyVerifications WarrantyVerification[]

  @@unique([serviceRequestId, position])
  @@index([orderDetailId, status])
  @@index([serviceRequestId, status])
  @@index([confirmationDueAt, status])
  @@map("service_request_items")
}

model WarrantyVerification {
  id                   Int                          @id @default(autoincrement())
  orderDetailId        Int
  serviceRequestItemId Int
  decision             WarrantyVerificationDecision
  warrantyStartAt      DateTime?
  warrantyEndAt        DateTime?
  verifiedById         Int
  internalNote         String?                      @db.Text
  createdAt            DateTime                     @default(now())

  orderDetail        OrderDetail        @relation(fields: [orderDetailId], references: [id], onDelete: Restrict)
  serviceRequestItem ServiceRequestItem @relation(fields: [serviceRequestItemId], references: [id], onDelete: Restrict)
  verifiedBy         User               @relation("WarrantyVerificationVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([orderDetailId, createdAt, id])
  @@index([serviceRequestItemId, createdAt, id])
  @@map("warranty_verifications")
}

model ServiceRequestEvent {
  id                   Int                       @id @default(autoincrement())
  serviceRequestId     Int
  serviceRequestItemId Int?
  actorId              Int?
  kind                 ServiceEventKind
  visibility           ServiceEventVisibility    @default(PUBLIC)
  fromStatus           ServiceRequestItemStatus?
  toStatus             ServiceRequestItemStatus?
  body                 String?                   @db.Text
  metadata             Json?
  createdAt            DateTime                  @default(now())

  request ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  item    ServiceRequestItem? @relation(fields: [serviceRequestItemId], references: [id], onDelete: SetNull)
  actor   User?               @relation("AfterSalesEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([serviceRequestId, createdAt, id])
  @@index([serviceRequestItemId, createdAt, id])
  @@map("service_request_events")
}

model ServiceRequestAttachment {
  id                   Int                     @id @default(autoincrement())
  serviceRequestId     Int
  serviceRequestItemId Int?
  eventId              Int?
  uploadedById         Int
  objectKey            String                  @unique @db.VarChar(512)
  uploadKey            String?                 @db.VarChar(64)
  uploadHash           String?                 @db.Char(64)
  uploadPosition       Int?                    @db.UnsignedSmallInt
  mimeType             String                  @db.VarChar(50)
  byteSize             Int
  width                Int
  height               Int
  visibility           ServiceEventVisibility  @default(PUBLIC)
  status               ServiceAttachmentStatus @default(PENDING)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  storageDeletedAt     DateTime?

  request  ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  item     ServiceRequestItem? @relation(fields: [serviceRequestItemId], references: [id], onDelete: SetNull)
  uploader User                @relation("AfterSalesAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([serviceRequestItemId, uploadKey, uploadPosition])
  @@index([serviceRequestId, createdAt])
  @@index([serviceRequestItemId, status, createdAt])
  @@index([status, updatedAt])
  @@map("service_request_attachments")
}

model ServiceQuote {
  id                   Int                @id @default(autoincrement())
  serviceRequestItemId Int
  version              Int
  status               ServiceQuoteStatus @default(SENT)
  currency             String             @default("VND") @db.Char(3)
  subtotal             Int
  total                Int
  note                 String?            @db.VarChar(1000)
  validUntil           DateTime
  createdById          Int
  respondedAt          DateTime?
  createdAt            DateTime           @default(now())

  item      ServiceRequestItem @relation(fields: [serviceRequestItemId], references: [id], onDelete: Restrict)
  createdBy User               @relation("AfterSalesQuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines     ServiceQuoteLine[]

  @@unique([serviceRequestItemId, version])
  @@index([serviceRequestItemId, status])
  @@index([validUntil, status])
  @@map("service_quotes")
}

model ServiceQuoteLine {
  id          Int    @id @default(autoincrement())
  quoteId     Int
  description String @db.VarChar(255)
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  position    Int    @db.UnsignedSmallInt

  quote ServiceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, position])
  @@map("service_quote_lines")
}

model Promotion {
  id             Int            @id @default(autoincrement())
  kind           PromotionKind
  state          PromotionState @default(DRAFT)
  name           String         @db.VarChar(150)
  description    String?        @db.VarChar(500)
  discountKind   DiscountKind
  discountValue  Int
  pricingVersion Int            @default(1)
  startsAt       DateTime
  endsAt         DateTime
  activatedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdById Int
  updatedById Int

  createdBy User @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("PromotionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  couponPolicy    CouponPolicy?
  automaticPolicy AutomaticPromotionPolicy?
  flashSalePolicy FlashSalePolicy?
  products        PromotionProduct[]
  redemptions     PromotionRedemption[]
  userUsages      PromotionUserUsage[]
  couponOrders    Order[]                   @relation("OrderCouponPromotion")
  automaticLines  OrderDetail[]             @relation("OrderDetailAutomaticPromotion")
  flashSaleQuotas FlashSaleProductQuota[]

  @@index([kind, state, startsAt, endsAt])
  @@map("promotions")
}

model CouponPolicy {
  promotionId    Int         @id
  code           String      @unique @db.VarChar(50)
  scope          CouponScope
  minOrderValue  Int         @default(0)
  maxDiscount    Int?
  maxUses        Int?
  usedCount      Int         @default(0)
  maxUsesPerUser Int         @default(1)
  isPublic       Boolean     @default(false)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([isPublic])
  @@map("coupon_policies")
}

model AutomaticPromotionPolicy {
  promotionId         Int     @id
  priority            Int     @default(0)
  stackableWithCoupon Boolean @default(false)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([priority])
  @@map("automatic_promotion_policies")
}

model PromotionProduct {
  promotionId Int
  productId   Int

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([promotionId, productId])
  @@index([productId, promotionId])
  @@map("promotion_products")
}

model PromotionUserUsage {
  promotionId Int
  userId      Int
  usedCount   Int @default(0)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([promotionId, userId])
  @@map("promotion_user_usages")
}

model PromotionRedemption {
  id             Int              @id @default(autoincrement())
  promotionId    Int
  userId         Int
  orderId        Int              @unique
  discountAmount Int
  status         RedemptionStatus @default(APPLIED)
  createdAt      DateTime         @default(now())
  reversedAt     DateTime?
  reverseReason  String?          @db.VarChar(50)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([promotionId, status, createdAt])
  @@index([userId, promotionId, status])
  @@map("promotion_redemptions")
}

model FlashSalePolicy {
  promotionId         Int     @id
  priority            Int     @default(0)
  stackableWithCoupon Boolean @default(false)
  showRemainingQuota  Boolean @default(true)

  promotion Promotion               @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  quotas    FlashSaleProductQuota[]

  @@map("flash_sale_policies")
}

model FlashSaleProductQuota {
  promotionId     Int
  productId       Int
  totalQuota      Int
  claimedUnits    Int      @default(0)
  maxUnitsPerUser Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  promotion   Promotion             @relation(fields: [promotionId], references: [id], onDelete: Restrict, map: "flash_sale_product_quotas_promotion_fkey")
  policy      FlashSalePolicy       @relation(fields: [promotionId], references: [promotionId], onDelete: Restrict, map: "flash_sale_product_quotas_policy_fkey")
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  usages      FlashSaleUserUsage[]
  allocations FlashSaleAllocation[]

  @@id([promotionId, productId])
  @@index([productId, promotionId])
  @@map("flash_sale_product_quotas")
}

model FlashSaleUserUsage {
  promotionId  Int
  productId    Int
  userId       Int
  claimedUnits Int @default(0)

  quota FlashSaleProductQuota @relation(fields: [promotionId, productId], references: [promotionId, productId], onDelete: Restrict)
  user  User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([promotionId, productId, userId])
  @@index([userId, promotionId])
  @@map("flash_sale_user_usages")
}

model FlashSaleAllocation {
  id             Int                       @id @default(autoincrement())
  promotionId    Int
  productId      Int
  userId         Int
  orderId        Int
  orderDetailId  Int                       @unique
  quantity       Int
  discountAmount Int
  status         FlashSaleAllocationStatus @default(CLAIMED)
  createdAt      DateTime                  @default(now())
  releasedAt     DateTime?
  releaseReason  String?                   @db.VarChar(50)

  quota       FlashSaleProductQuota @relation(fields: [promotionId, productId], references: [promotionId, productId], onDelete: Restrict)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderDetail OrderDetail           @relation(fields: [orderDetailId], references: [id], onDelete: Restrict)

  @@unique([promotionId, productId, orderId])
  @@index([promotionId, productId, status])
  @@index([userId, promotionId, status])
  @@index([createdAt])
  @@map("flash_sale_allocations")
}

model Review {
  id            Int @id @default(autoincrement())
  userId        Int
  productId     Int
  orderDetailId Int @unique

  rating           Int          @db.UnsignedTinyInt
  title            String?      @db.VarChar(150)
  content          String       @db.VarChar(1500)
  isAnonymous      Boolean
  status           ReviewStatus @default(PUBLISHED)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  contentUpdatedAt DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  hiddenReason  String?   @db.VarChar(500)
  moderatedAt   DateTime?
  moderatedById Int?

  images       ReviewImage[]
  helpfulVotes ReviewHelpful[]
  reply        ReviewReply?

  user        User        @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id], onDelete: Restrict)
  moderatedBy User?       @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status, deletedAt, createdAt])
  @@index([status, deletedAt, createdAt])
  @@map("reviews")
}

model ReviewImage {
  id               Int               @id @default(autoincrement())
  reviewId         Int
  objectKey        String            @unique @db.VarChar(512)
  mimeType         String            @db.VarChar(50)
  byteSize         Int
  width            Int
  height           Int
  position         Int               @db.UnsignedTinyInt
  status           ReviewImageStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  storageDeletedAt DateTime?

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([reviewId, status, position])
  @@index([status, updatedAt])
  @@map("review_images")
}

model ReviewHelpful {
  reviewId  Int
  userId    Int
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([reviewId, userId])
  @@index([userId, createdAt])
  @@map("review_helpful")
}

model ReviewReply {
  id          Int       @id @default(autoincrement())
  reviewId    Int       @unique
  content     String    @db.VarChar(1000)
  createdById Int
  updatedById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  createdBy User   @relation("ReviewReplyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User   @relation("ReviewReplyUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([deletedAt, updatedAt])
  @@map("review_replies")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.Char(64)
  familyId  String    @db.Char(36)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(255)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@index([familyId])
  @@map("refresh_tokens")
}

model OrderStatusHistory {
  id         Int      @id @default(autoincrement())
  fromStatus String?  @db.VarChar(20)
  toStatus   String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId Int?
  reason  String? @db.VarChar(50)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id            String    @id @default(uuid()) @db.Char(36)
  orderId       Int       @unique
  provider      String    @db.VarChar(20)
  method        String    @default("BANK_TRANSFER") @db.VarChar(30)
  status        String    @default("PENDING") @db.VarChar(20)
  amount        Int
  currency      String    @default("VND") @db.Char(3)
  transferCode  String    @unique @db.VarChar(32)
  bankCode      String    @db.VarChar(30)
  accountNumber String    @db.VarChar(64)
  accountName   String    @db.VarChar(255)
  expiresAt     DateTime
  cancelAfter   DateTime
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id])
  webhookEvents PaymentWebhookEvent[]

  @@index([status, cancelAfter])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                     String    @id @default(uuid()) @db.Char(36)
  provider               String    @db.VarChar(20)
  source                 String    @db.VarChar(20)
  providerEventId        String    @db.VarChar(150)
  providerTransactionKey String    @db.VarChar(150)
  paymentId              String?
  direction              String    @db.VarChar(10)
  amount                 Int
  currency               String    @default("VND") @db.Char(3)
  transferCode           String?   @db.VarChar(64)
  accountNumber          String?   @db.VarChar(64)
  occurredAt             DateTime?
  status                 String    @default("REVIEW_REQUIRED") @db.VarChar(30)
  reviewReason           String?   @db.VarChar(40)
  payloadHash            String    @db.Char(64)
  rawPayload             Bytes?    @db.LongBlob
  rawPayloadIv           Bytes?    @db.VarBinary(16)
  rawPayloadTag          Bytes?    @db.VarBinary(16)
  encryptionKeyId        String?   @db.VarChar(32)
  note                   String?   @db.VarChar(500)
  receivedAt             DateTime  @default(now())
  resolvedAt             DateTime?
  resolvedById           Int?

  payment    Payment? @relation(fields: [paymentId], references: [id])
  resolvedBy User?    @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@unique([provider, providerTransactionKey])
  @@index([status, receivedAt])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model PaymentProviderCheckpoint {
  id              Int       @id @default(autoincrement())
  provider        String    @db.VarChar(20)
  mode            String    @db.VarChar(20)
  cursor          String?   @db.VarChar(150)
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastErrorAt     DateTime?
  lastError       String?   @db.VarChar(500)
  updatedAt       DateTime  @updatedAt

  @@unique([provider, mode])
  @@map("payment_provider_checkpoints")
}

model StockMovement {
  id             Int      @id @default(autoincrement())
  delta          Int
  reason         String   @db.VarChar(20)
  note           String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  balanceBefore  Int
  balanceAfter   Int
  idempotencyKey String?  @db.VarChar(64)
  requestHash    String?  @db.Char(64)

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId Int?

  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId Int?

  receipt   StockReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  receiptId String?       @db.Char(36)

  @@unique([actorId, idempotencyKey])
  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([receiptId])
  @@map("stock_movements")
}

model StockReceipt {
  id           String    @id @default(uuid()) @db.Char(36)
  code         String    @unique @db.VarChar(40)
  supplierName String?   @db.VarChar(255)
  status       String    @default("DRAFT") @db.VarChar(20)
  note         String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  postedAt     DateTime?

  createdBy   User  @relation("ReceiptCreator", fields: [createdById], references: [id])
  createdById Int
  postedBy    User? @relation("ReceiptPoster", fields: [postedById], references: [id])
  postedById  Int?

  items     StockReceiptItem[]
  movements StockMovement[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id        Int    @id @default(autoincrement())
  receiptId String @db.Char(36)
  productId Int
  quantity  Int
  unitCost  Int?

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([receiptId, productId])
  @@index([productId])
  @@map("stock_receipt_items")
}
