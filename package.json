{
  "name": "nodejs-pro",
  "version": "1.0.0",
  "description": "nodejs-pro",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/server.js",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"require('fs').cpSync('src/views','dist/views',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prisma:deploy": "prisma migrate deploy",
    "prepare": "husky"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuocDuy21-10/nodejs-pro.git"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "duy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/QuocDuy21-10/nodejs-pro/issues"
  },
  "homepage": "https://github.com/QuocDuy21-10/nodejs-pro#readme",
  "dependencies": {
    "@prisma/client": "6.3.0",
    "@quixo3/prisma-session-store": "3.1.13",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "5.0.1",
    "express-session": "1.18.1",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.12.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "uuid": "11.0.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.0",
    "@types/express-session": "1.18.1",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.7",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.2",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.9",
    "prettier": "3.9.10",
    "prisma": "6.3.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.8",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.2"
  }
}
