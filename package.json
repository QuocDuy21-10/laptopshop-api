{
  "name": "laptopshop-api",
  "version": "1.0.0",
  "description": "laptopshop-api",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/server.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:int": "jest -c jest.int.config.ts --runInBand",
    "products:audit-facets": "ts-node -r tsconfig-paths/register src/scripts/audit-product-facets.ts",
    "products:audit-rating": "ts-node -r tsconfig-paths/register src/scripts/audit-product-rating-query.ts",
    "inventory:verify-ledger": "ts-node -r tsconfig-paths/register src/scripts/verify-stock-ledger.ts",
    "promotions:verify-flash-sale": "ts-node -r tsconfig-paths/register src/scripts/verify-flash-sale.ts",
    "review-images:reconcile": "ts-node -r tsconfig-paths/register src/scripts/reconcile-review-images.ts",
    "price-alerts:run-once": "ts-node -r tsconfig-paths/register src/scripts/run-price-alert-sweep.ts",
    "worker:price-alert": "ts-node -r tsconfig-paths/register src/workers/price-alert-worker.ts",
    "prisma:deploy": "prisma migrate deploy",
    "prepare": "husky"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuocDuy21-10/laptopshop-api.git"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "duy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/QuocDuy21-10/laptopshop-api/issues"
  },
  "homepage": "https://github.com/QuocDuy21-10/laptopshop-api#readme",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/s3-request-presigner": "3.1154.0",
    "@prisma/client": "6.3.0",
    "@sentry/node": "11.8.0",
    "bcrypt": "5.1.1",
    "bullmq": "^6.4.0",
    "compression": "1.8.2",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.0.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.12.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.3.0",
    "rate-limit-redis": "6.0.1",
    "redis": "5.12.1",
    "sharp": "0.35.5",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.0.5",
    "web-push": "^3.6.7",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "5.0.2",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/hpp": "0.2.7",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.7",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@types/web-push": "^3.6.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.2",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.9",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.8",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.2"
  }
}
